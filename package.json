{
  "name": "dsh-running-sessions",
  "version": "1.3.5",
  "type": "module",
  "description": "DeepSeek Harness client plugin: a title-bar pill that lists running and recently finished sessions for one-click switching, and nests each sub-agent under the session that owns it.",
  "license": "MIT",
  "author": "ERroooooR",
  "homepage": "https://github.com/ERroooooR/dsh-running-sessions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ERroooooR/dsh-running-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/ERroooooR/dsh-running-sessions/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-web-plugin",
    "session",
    "ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "build.mjs",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "pretest": "node build.mjs --check",
    "test": "node test/contract.test.mjs && node test/roster.test.mjs && node test/press.test.mjs && node test/render.test.mjs && node test/integration.test.mjs && node test/bundle.test.mjs",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
