# `client.js` is generated by `build.mjs`, which always writes LF. Without this
# pin, a Windows checkout with core.autocrlf=true rewrites the line endings and
# `build.mjs --check` (run by `npm test`) then reports a stale bundle on a clean
# tree.
client.js text eol=lf
build.mjs text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Shell scripts run under bash, where a CRLF line ending is a syntax error. A
# Windows checkout with core.autocrlf=true would otherwise break them.
*.sh text eol=lf
